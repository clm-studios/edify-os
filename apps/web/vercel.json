{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @edify/shared build && cd apps/web && npx next build",
  "framework": "nextjs",
  "functions": {
    "src/app/api/team/[slug]/chat/route.ts": { "maxDuration": 60 },
    "src/app/api/decision-lab/route.ts": { "maxDuration": 60 },
    "src/app/api/decision-lab/follow-up/route.ts": { "maxDuration": 60 },
    "src/app/api/heartbeat/trigger/route.ts": { "maxDuration": 60 },
    "src/app/api/briefing/generate/route.ts": { "maxDuration": 60 },
    "src/app/api/cron/sweep-stuck-streams/route.ts": { "maxDuration": 60 },
    "src/app/api/proof-library/extract-pending/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/heartbeat/trigger",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/briefing/generate",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/cron/sweep-stuck-streams",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/proof-library/extract-pending",
      "schedule": "0 0 * * *"
    }
  ]
}
